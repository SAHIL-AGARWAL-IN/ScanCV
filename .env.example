# Backend environment — copy to .env and fill in.
# NEVER commit the real .env (it's in .gitignore).

# Supabase project: dashboard → Project Settings → API
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_KEY=<service_role key — backend DB writes, bypasses RLS>
SUPABASE_ANON_KEY=<publishable/anon key — frontend auth calls>
SUPABASE_JWT_SECRET=<JWT secret — used to verify access tokens>

# Groq: https://console.groq.com
GROQ_API_KEY=<gsk_...>

# Optional overrides
# GROQ_MODEL=openai/gpt-oss-120b
# SENTENCE_TRANSFORMER_MODEL=all-MiniLM-L6-v2
