# Streamlit secrets — copy to frontend/.streamlit/secrets.toml and fill in.
# The frontend also falls back to the project-root .env, so this is only
# needed if you deploy the frontend separately (e.g. Streamlit Community Cloud).
# NEVER commit the real secrets.toml.

[backend]
url = "http://localhost:8000"

[supabase]
SUPABASE_URL = "https://<project-ref>.supabase.co"
SUPABASE_ANON_KEY = "<publishable/anon key>"
